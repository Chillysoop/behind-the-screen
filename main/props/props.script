-- Generated by tools/generate.py: per-prop shininess and glow.
-- The evening (M7): "mood" { window = glow, fairy = glow, seconds } dims the window
-- as night falls outside and brings the fairy lights up.

local GLOW = {}

function init(self)
    go.set("#floor", "surface", vmath.vector4(0.12, 18.0, 0.0, 0))
    go.set("#walls", "surface", vmath.vector4(0.0, 8.0, 0.0, 0))
    go.set("#window_frame", "surface", vmath.vector4(0.1, 12.0, 0.0, 0))
    go.set("#window_glass", "surface", vmath.vector4(0.0, 8.0, 0.75, 0))
    go.set("#rug", "surface", vmath.vector4(0.0, 8.0, 0.0, 0))
    go.set("#table", "surface", vmath.vector4(0.18, 22.0, 0.0, 0))
    go.set("#battlemat", "surface", vmath.vector4(0.02, 8.0, 0.0, 0))
    go.set("#tray", "surface", vmath.vector4(0.18, 22.0, 0.0, 0))
    go.set("#tray_felt", "surface", vmath.vector4(0.0, 8.0, 0.0, 0))
    go.set("#dm_screen", "surface", vmath.vector4(0.08, 12.0, 0.0, 0))
    go.set("#sheets", "surface", vmath.vector4(0.02, 8.0, 0.0, 0))
    go.set("#tableware", "surface", vmath.vector4(0.35, 40.0, 0.0, 0))
    go.set("#bookshelf", "surface", vmath.vector4(0.05, 10.0, 0.0, 0))
    go.set("#plant", "surface", vmath.vector4(0.05, 10.0, 0.0, 0))
    go.set("#fairy_lights", "surface", vmath.vector4(0.0, 8.0, 1.3, 0))
    GLOW.window_glass = { s = 0.0, sh = 8.0, e = 0.75 }
    GLOW.fairy_lights = { s = 0.0, sh = 8.0, e = 1.3 }
    self.fade = nil
end

local function set_glow(name, e)
    local g = GLOW[name]
    g.e = e
    go.set("#" .. name, "surface", vmath.vector4(g.s, g.sh, e, 0))
end

function update(self, dt)
    local f = self.fade
    if not f then
        return
    end
    f.t = math.min(f.t + dt, f.seconds)
    local k = f.seconds > 0 and f.t / f.seconds or 1
    for name, to in pairs(f.to) do
        set_glow(name, f.from[name] + (to - f.from[name]) * k)
    end
    if f.t >= f.seconds then
        self.fade = nil
    end
end

function on_message(self, message_id, message)
    if message_id == hash("mood") then
        local f = { t = 0, seconds = message.seconds or 2, from = {}, to = {} }
        if message.window then
            f.from.window_glass, f.to.window_glass = GLOW.window_glass.e, message.window
        end
        if message.fairy then
            f.from.fairy_lights, f.to.fairy_lights = GLOW.fairy_lights.e, message.fairy
        end
        self.fade = f
    end
end
