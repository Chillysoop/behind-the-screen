-- The gifts on the DM's side of the table (game/model/keepsakes.lua): every keepsake a player has
-- given you, set out right of the DM screen in the order you got them. "place" { list = { id, ... },
-- new = id } puts them out; the new one drops in. The meshes are tools/gen_keepsakes.py.

local scene = require "main.scene_data"

-- Where they go, right of the screen first (x, z, and a turn toward the DM's chair).
local SLOTS = {
    { 28, 38, -0.35 },
    { 42, 33.5, -0.6 },
    { 37, 47, -0.5 },
    { 57, 44, -0.8 },
    { 14, 35, -0.15 },
    { 52, 30, -0.7 },
}

local function clear(self)
    for _, id in pairs(self.out or {}) do
        go.delete(id)
    end
    self.out = {}
end

local function place(self, list, new)
    clear(self)
    local y = scene.grid.y - 0.15
    for i, kind in ipairs(list or {}) do
        local s = SLOTS[i]
        if s then
            local pos = vmath.vector3(s[1], y, s[2])
            local ok, id = pcall(factory.create, "#" .. kind, pos + vmath.vector3(0, kind == new and 14 or 0, 0),
                vmath.quat_rotation_y(s[3]))
            if ok and id then
                self.out[kind] = id
                if kind == new then
                    go.animate(id, "position.y", go.PLAYBACK_ONCE_FORWARD, y, go.EASING_OUTBOUNCE, 0.7, 0.25)
                end
            end
        end
    end
end

function init(self)
    self.out = {}
end

function final(self)
    clear(self)
end

function on_message(self, message_id, message)
    if message_id == hash("place") then
        place(self, message.list, message.new)
    end
end
