-- Pendant lamp over the table: sways a touch, flickers a touch, and drives
-- the two lights (lamp + campfire) that every lit material uses.
-- Press L to dim it; the imagination zoom dims it further and wakes the fire.
-- A big moment at the table (a crit, a payoff, a level-up) sends "pulse" { amount }:
-- the lamp and the fire swell for a beat and settle (M7).

local state = require "main.state"
local scene = require "main.scene_data"

local HALO = "/lamp_halo"

function init(self)
    self.t = 0
    self.pivot = go.get_position()
    self.level, self.goal = 1.0, 1.0
    self.pulse, self.pulse_rate = 0, 2.5
    go.set("#bulb", "surface", vmath.vector4(0, 1, 1.6, 0))
    go.set("#body", "surface", vmath.vector4(0.25, 24, 0, 0))
end

function update(self, dt)
    self.t = self.t + dt
    local t = self.t

    local rot = vmath.quat_rotation_x(math.sin(t * 0.55) * 0.018) * vmath.quat_rotation_z(math.sin(t * 0.41 + 1.3) * 0.014)
    go.set_rotation(rot)
    local bulb = self.pivot + vmath.rotate(rot, scene.lamp.bulb_offset)
    state.lamp_pos = bulb

    self.level = self.level + (self.goal - self.level) * (1 - math.exp(-3 * dt))
    local imag = state.imagination
    local flicker = 1 + 0.012 * math.sin(t * 13.1) + 0.008 * math.sin(t * 7.3 + 2)
    self.pulse = self.pulse * math.exp(-self.pulse_rate * dt)
    local lamp_i = self.level * flicker * (1 - 0.4 * imag) * (1 + self.pulse)

    local f = 0.78 + 0.13 * math.sin(t * 11.0) + 0.08 * math.sin(t * 17.3 + 1.7) + 0.05 * math.sin(t * 29.1)
    state.fire_intensity = f
    local fire_i = f * (0.3 + 1.2 * imag) * (state.fire_level or 1) * (1 + 1.5 * self.pulse)
    local fp = state.fire_pos or scene.fire

    msg.post("@render:", "lights", {
        lamp = vmath.vector4(bulb.x, bulb.y, bulb.z, lamp_i),
        fire = vmath.vector4(fp.x, fp.y + 3, fp.z, fire_i),
    })

    go.set_position(bulb + vmath.vector3(0, -2, 0), HALO)
    go.set(msg.url(nil, HALO, "sprite"), "glow", vmath.vector4(0.55 * lamp_i, 0, 0, 0))
    go.set("#bulb", "surface", vmath.vector4(0, 1, 1.6 * lamp_i, 0))
end

function on_message(self, message_id, message)
    if message_id == hash("toggle") then
        self.goal = (self.goal > 0.8) and 0.5 or 1.0
    elseif message_id == hash("pulse") then
        self.pulse = math.max(self.pulse, message.amount or 0.3)
        self.pulse_rate = 1 / math.max(message.seconds or 0.4, 0.05)
    end
end
