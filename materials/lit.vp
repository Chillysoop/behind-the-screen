#version 140

in highp vec4 position;
in mediump vec2 texcoord0;
in mediump vec3 normal;

out highp vec3 var_world_pos;
out mediump vec3 var_normal;
out mediump vec2 var_texcoord0;

uniform vs_uniforms
{
    highp mat4 mtx_world;
    highp mat4 mtx_viewproj;
};

void main()
{
    vec4 wp = mtx_world * vec4(position.xyz, 1.0);
    var_world_pos = wp.xyz;
    var_normal = normalize(mat3(mtx_world) * normal);
    var_texcoord0 = texcoord0;
    gl_Position = mtx_viewproj * wp;
}
