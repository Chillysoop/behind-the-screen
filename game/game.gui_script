-- Behind the Screen: prep -> game night -> report -> next week.
-- The model lives in game/model (pure Lua); this script draws it and wires up
-- the camera, the HUD, the physical d20 and (M4) the table, which stages game
-- night with terrain, minis and the players' poses.

local config_ok, config_value = pcall(sys.get_config_int, "streamlined.enabled", 0)
local STREAMLINED = config_ok and config_value == 1

local kit = require "game.ui.kit"
local gloss = not STREAMLINED and require "game.ui.gloss"   -- rules words explained on hover (sets kit's text hook)
local campaign_mod = not STREAMLINED and require "game.model.campaign"
local telemetry = not STREAMLINED and require "game.model.telemetry"
local dialogue = not STREAMLINED and require "game.model.dialogue"
local save = not STREAMLINED and require "game.model.save"
local content = not STREAMLINED and require "game.model.content"
local ambience = not STREAMLINED and require "game.ui.ambience"
local guide_view = not STREAMLINED and require "game.ui.guide_view"
local intro_view = not STREAMLINED and require "game.ui.intro_view"
local prep_view = not STREAMLINED and require "game.ui.prep_view"
local prep_steps = not STREAMLINED and require "game.ui.prep_steps"
local night_view = not STREAMLINED and require "game.ui.night_view"
local report_view = not STREAMLINED and require "game.ui.report_view"
local debug_view = not STREAMLINED and require "game.ui.debug_view"
local review_view = not STREAMLINED and require "game.ui.review_view"
local setup_view = not STREAMLINED and require "game.ui.setup_view"
local steps_view = not STREAMLINED and require "game.ui.steps"
local messages_view = not STREAMLINED and require "game.ui.messages_view"
local levelup_view = not STREAMLINED and require "game.ui.levelup_view"
local slice_end_view = not STREAMLINED and require "game.ui.slice_end_view"
local notes_view = not STREAMLINED and require "game.ui.notes_view"
local ask_view = not STREAMLINED and require "game.ui.ask_view"
local talk_view = not STREAMLINED and require "game.ui.talk_view"
local book_view = not STREAMLINED and require "game.ui.book_view"
local lore_view = not STREAMLINED and require "game.ui.lore_view"
local sheet_view = not STREAMLINED and require "game.ui.sheet_view"
local encounter_view = not STREAMLINED and require "game.ui.encounter_view"
local input_trace = not STREAMLINED and require "game.ui.input_trace"
local story_log_view = not STREAMLINED and require "game.ui.story_log_view"
local dice_sets = not STREAMLINED and require "game.model.dice_sets"

local CAMERA = "/camera#camera"
local HUD = "/hud#hud"
local DICE = "/dice#dice"
local TABLE = "/table#table"
local KEEPSAKES = "/keepsakes#keepsakes"   -- the players' gifts on your side of the table

local A = {
    touch = hash("touch"),
    roll = hash("roll"),
    fast = hash("fast"),
    slow = hash("slow"),         -- G: half speed and back (the newcomer playtest, October 16)
    debug = hash("debug"),
    sandbox = hash("sandbox"),
    confirm = hash("confirm"),
    log = hash("log"),
    timer = hash("timer"),
    music = hash("music"),
    dm_rolls = hash("dm_rolls"),
    snapshot = hash("snapshot"),   -- C: the DM's camera on game night (B1)
    review = hash("review"),
    queue = hash("queue"),
    back = hash("back"),
    text = hash("text"),
    backspace = hash("backspace"),
    notes = hash("next_cell"),   -- N: the DM's notes (it's "next cell" in the review queue)
    story = hash("story"),       -- S: the Story log (October 13)
    wheel_up = hash("zoom_in"),
    wheel_down = hash("zoom_out"),
}

-- Number keys: the camera on game night, but a card's options while one is up (the fix pass).
local NUMKEY = {
    [hash("zoom_room")] = 1, [hash("zoom_table")] = 2, [hash("zoom_imagination")] = 3, [hash("zoom_dice")] = 4,
    [hash("key5")] = 5, [hash("key6")] = 6,
}

local function block_camera(on)
    msg.post(CAMERA, "block_input", { on = on })
end

local function write_playtest_line(app, line)
    local ok, err = pcall(function()
        local f = io.open(app.log_path, "a")
        if f then
            f:write(line, "\n")
            f:close()
        end
    end)
    if not ok then
        print("playtest log: " .. tostring(err))
    end
end

-- Dev safety net: any Lua error in a click, a message or game night playback
-- is printed, appended to error_log.txt next to the playtest log, and shown
-- on screen instead of silently leaving the game stuck.
local function show_error(self, err)
    local app = self.app
    print("[game] ERROR " .. tostring(err))
    write_playtest_line({ log_path = sys.get_save_file("behind_the_screen", "error_log.txt") }, tostring(err))
    pcall(function()
        if app.error_layer then
            kit.drop(app.error_layer)
        end
        app.error_layer = kit.layer("error")
        kit.box(40, 40, kit.W - 80, 330, kit.rgba("#3a1410", 0.96), { radius = 10 })
        kit.text(60, 54, "Something broke. The game may be stuck; the details are in error_log.txt, in the same folder as the playtest log.",
            "ui18b", kit.rgba("#ffd0c0"), { w = kit.W - 120 })
        kit.text(60, 86, tostring(err), "ui14", kit.rgba("#ffe8e0"), { w = kit.W - 120, lines = 15 })
    end)
end

local function guard(self, fn, ...)
    local ok, err = xpcall(fn, debug.traceback, ...)
    if not ok then
        show_error(self, err)
    end
    return ok and err
end

-- Saving between sessions (M7). The campaign is saved after Session Zero and after every
-- game night, so a tester can stop after any session and carry on later. A failed save
-- never stops the game; it's noted in error_log.txt.
-- Write the new save beside the old one, read it back, and only then swap it in, keeping
-- the previous save as .bak until the swap has worked. A full disk never costs the old save.
local function write_file(path, text)
    local tmp, bak = path .. ".tmp", path .. ".bak"
    local f = io.open(tmp, "wb")
    if not f then
        return false
    end
    local ok = f:write(text)
    ok = f:close() and ok
    local back = ok and io.open(tmp, "rb")
    local same = back and back:read("*a") == text
    if back then
        back:close()
    end
    if not same then
        os.remove(tmp)
        return false
    end
    os.remove(bak)
    local had_old = os.rename(path, bak)
    if not had_old then
        os.remove(path) -- a .bak we couldn't clear: don't let it block every save after this
    end
    if os.rename(tmp, path) then
        return true
    end
    if had_old then
        os.rename(bak, path)
    end
    -- The verified .tmp stays: find_save falls back to it (and to .bak).
    return false
end

local function save_campaign(app)
    local ok, err = pcall(function()
        local text = save.dump(app.campaign)
        assert(write_file(app.save_path, text), "couldn't write " .. tostring(app.save_path))
    end)
    if not ok then
        write_playtest_line({ log_path = sys.get_save_file("behind_the_screen", "error_log.txt") }, "save: " .. tostring(err))
    end
    return ok
end

-- The saved campaign, if there is one: { head = { week, seed, ... }, text = ... }.
-- The save, or if the game stopped halfway through swapping files, the new one still
-- waiting as .tmp or the previous one as .bak.
local function find_save(app)
    for _, path in ipairs({ app.save_path, app.save_path .. ".tmp", app.save_path .. ".bak" }) do
        local ok, found = pcall(function()
            local f = io.open(path, "rb")
            if not f then
                return nil
            end
            local text = f:read("*a")
            f:close()
            local head = save.peek(text)
            return head and { head = head, text = text } or nil
        end)
        if ok and found then
            return found
        end
    end
    return nil
end

local function build_screen(self)
    local app = self.app
    kit.clear_all()
    kit.reset_hover()
    kit.gloss_tags = nil     -- (a screen that broke mid-draw never leaves the glossary on)
    app.layers = {}
    if app.sandbox then
        return
    end
    local s = app.screen
    if s == "intro" then
        kit.layer("intro")
        intro_view.build(app)
        block_camera(false)
    elseif s == "prep" then
        kit.layer("prep")
        prep_view.build(app)
        block_camera(true)
    elseif s == "night" then
        night_view.build(app)
        block_camera(false)
    elseif s == "report" then
        kit.layer("report")
        report_view.build(app)
        block_camera(true)
    elseif s == "setup" then
        -- Setting up the campaign, one decision at a time (October 26), at the table with your friends.
        kit.layer("setup")
        setup_view.build(app)
        block_camera(true)
    elseif s == "lore" then
        -- Between the prep board and the night (October 16): what tonight can change in the story.
        kit.layer("lore")
        lore_view.build(app)
        block_camera(true)
    elseif s == "join" then
        -- Someone joins a small table (October 15): their backstory, a step at a time, then the week.
        kit.layer("join")
        setup_view.build_join(app)
        block_camera(true)
    elseif s == "slice_end" then
        kit.layer("slice_end")
        slice_end_view.build(app)
        block_camera(true)
    end
    -- M6 modals: a conversation, the level-up moment.
    if app.convo and s == "prep" then
        messages_view.modal(app)
    end
    if app.levelup then
        levelup_view.modal(app)
    end
    if app.debug then
        debug_view.build(app)
    end
    -- The real-session pass: the DM's notes, a character sheet, the encounter builder.
    if app.overlay == "notes" and (s == "prep" or s == "night" or s == "report") then
        notes_view.draw(app)
    elseif app.overlay == "sheet" and (s == "prep" or s == "night" or s == "report") then
        sheet_view.draw(app)
    elseif app.overlay == "encounter" and s == "prep" then
        encounter_view.draw(app)
    else
        app.overlay = nil
    end
    -- An "are you sure?" (the slice rework) sits over everything but the tips.
    if app.talk and s == "prep" then
        talk_view.draw(app)
    end
    if app.book and s == "prep" then
        book_view.draw(app)       -- reading a new book (A13)
    end
    if app.ask then
        ask_view.draw(app)
    end
    review_view.rebuild(app)
    guide_view.refresh(app)   -- the first-session tips, on top
end

function init(self)
    -- The separate Streamlined build has its own campaign, interface and save namespace.
    -- Ordinary builds keep the original game and its saves exactly as before.
    if STREAMLINED then
        self.guided_app = require "game.ui.guided_app"
        self.guided_app.init(self)
        return
    end
    msg.post(".", "acquire_input_focus")
    gui.set_render_order(4)
    self.refocused = false
    local app = {
        campaign = campaign_mod.new(os.time()),
        screen = "intro",
        layers = {},
        sel = nil,
        fast = false,
        debug = false,
        sandbox = false,
        time = 0,
        log_path = sys.get_save_file("behind_the_screen", "playtest_log.jsonl"),
        tester_build = dialogue.playtest_build(), -- testers' build
        -- The developer keys (F2 free camera, F3 the numbers) only in a debug build, like F4's review
        -- (October 20: a release export showed and enabled them).
        dev_keys = dialogue.dev_build() and not dialogue.playtest_build(),
    }
    -- The old night, for comparison (game.project [behind_the_screen] old_night = 1): the wander-off
    -- and split-the-party cards instead of the players' pulls (game/model/pulls.lua).
    local ok_old, old_night = pcall(sys.get_config_int, "behind_the_screen.old_night", 0)
    if ok_old and old_night == 1 then
        app.campaign.old_night = true
    end
    self.app = app
    app.save_path = sys.get_save_file("behind_the_screen", "campaign_save.txt")
    app.resume = find_save(app)
    app.save_campaign = function()
        return save_campaign(app)
    end
    -- Pick the saved campaign back up: next week's prep, or the end of the first act if
    -- they stopped before its survey.
    app.continue_campaign = function()
        local c, err = save.load(app.resume and app.resume.text)
        if not c then
            app.resume = nil
            app.resume_error = tostring(err)
            build_screen(self)
            return
        end
        app.campaign = c
        app.resume = nil
        if c.at_night and c.prep then
            -- Saved at "Run game night": the same board, the same night, from its start.
            app.go("night")
        elseif c.at_prep and c.prep then
            -- Saved mid-prep (A11): the same board, the week not dealt again.
            app.go("prep", { resume = true })
        elseif c.week >= content.arc.SESSIONS and not c.slice_survey_done then
            app.slice_seen = true
            app.go("slice_end")
        else
            app.go("prep")
        end
    end
    -- Development builds read the dialogue straight from the project folder when they
    -- can find it, so the review mode's decisions land in lines.json.
    if review_view.available() then
        review_view.attach_project(app)
    end

    app.refresh = function()
        build_screen(self)
        if app.screen == "prep" then
            app.prep_dirty = true   -- something on the board may have moved: autosave soon
        end
    end
    local function looked(what)
        local c = app.campaign
        c.looked = c.looked or {}
        c.looked[what] = (c.looked[what] or 0) + 1
    end
    app.open_sheet = function(key)
        looked("sheets")
        if app.overlay == "notes" then
            notes_view.close(app)
        end
        sheet_view.open(app, key)
        guide_view.refresh(app)   -- tips step aside while a sheet is open
    end
    app.open_notes = function(tab)
        looked("notes")
        if app.overlay == "sheet" then
            sheet_view.close(app)
        end
        notes_view.open(app, tab)
        guide_view.refresh(app)
    end
    app.open_encounter = function(i)
        looked("fights")
        encounter_view.open(app, i)
        guide_view.refresh(app)
    end
    app.run_night = function()
        prep_view.run_night(app)
    end
    app.close_overlay = function()
        local was_notes = app.overlay == "notes"
        notes_view.close(app)
        sheet_view.close(app)
        encounter_view.close(app)
        app.overlay = nil
        if was_notes and app.screen == "prep" then
            build_screen(self)   -- the notes can change the hand (pins, shelves, the world's cards)
        end
        guide_view.refresh(app)
    end
    -- Extra lines for the playtest log (M7: the quick questions and the slice survey).
    app.log_line = function(line)
        write_playtest_line(app, line)
    end
    -- Anything for the table (the people's poses and seats, its tracking): steps.lua's bubbles.
    app.table_post = function(name, data)
        msg.post(TABLE, name, data)
    end
    app.zoom = function(index)
        -- Always ask: the player may have moved the camera with the number keys.
        app.camera_index = index
        msg.post(CAMERA, "set_zoom", { index = index })
    end
    -- A9: the full roll lands in a tray: the player's own, or the DM's open box or hidden tray.
    app.roll_dice = function(tray)
        msg.post(CAMERA, "set_tray", { tray = tray or "dm_open" })
        msg.post(DICE, "roll", { reply = true, tray = tray or "dm_open" })
    end
    -- The shelf of fallen heroes (B3): every character who died and stayed dead.
    app.update_shelf = function()
        local list = {}
        for _, f in ipairs(app.campaign.fallen or {}) do
            local classes = { fighter = "fighter", rogue = "rogue", cleric = "cleric", wizard = "wizard" }
            table.insert(list, f.mini or classes[f.class] or "fighter")
        end
        msg.post(TABLE, "shelf", { list = list })
    end
    -- The report's snapshots (B7): set the moment back up on the table, or clear it.
    app.restage = function(sn)
        night_view.restage_snapshot(app, sn)
    end
    -- Whose dice look like what: the DM's set behind the screen, each player's in their tray.
    app.paint_dice = function()
        msg.post(DICE, "sets", { sets = dice_sets.by_tray(app.campaign) })
    end
    -- The players' gifts (game/model/keepsakes.lua) on your side of the table; the new one drops in.
    app.place_keepsakes = function(new)
        msg.post(KEEPSAKES, "place", { list = require("game.model.keepsakes").on_table(app.campaign), new = new })
    end
    -- Handouts at the players' seats (game/model/handouts.lua); `new` is the seat that just got one.
    app.place_handouts = function(new)
        local seats = require("game.model.handouts").at_seats(app.campaign)
        -- Tonight's, landed but not yet filed with the campaign (finish_night), go out too.
        local night = app.campaign.night
        for card, key in pairs(night and night.handouts_landed or {}) do
            local c = require("game.model.content").components[card]
            if c and not night.filed then
                seats[key] = seats[key] or {}
                table.insert(seats[key], require("game.model.handouts").kind(c))
            end
        end
        msg.post(KEEPSAKES, "handouts", { seats = seats, new = new })
    end
    app.jail_die = function(tray)
        msg.post(DICE, "jail", { tray = tray })
    end
    app.set_tray = function(tray)
        msg.post(CAMERA, "set_tray", { tray = tray })
    end
    -- A quick check: the player's die tumbles in their tray and lands on the number at once.
    app.tumble_die = function(tray, value)
        msg.post(DICE, "tumble", { tray = tray, value = value })
    end
    app.refresh_debug = function()
        if app.debug then
            debug_view.refresh(app)
        end
    end
    app.go = function(screen, opts)
        guide_view.left_screen(app, app.screen)
        app.overlay = nil
        if screen == "prep" and not (opts and (opts.resume or opts.welcomed)) and app.campaign.joiner_due
            and app.campaign:joiner_due() then
            -- A player joins this week (a small table, October 15): welcome them first.
            app.join = { key = app.campaign:joiner_due() }
            app.screen = "join"
            -- The room, everyone in their chairs and the newcomer pulling one up.
            app.zoom(1)
            msg.post(TABLE, "track", { on = true })
            build_screen(self)
            ambience.screen(app, "session_zero")
            return
        end
        -- From the prep board, the lore screen first (October 16: "this should help telegraph what
        -- upcoming lore decisions will mean for the DM"); its button runs the night.
        if screen == "night" and app.screen == "prep" and not (opts and opts.lore_seen) and app.campaign.prep then
            app.screen = "lore"
            build_screen(self)
            ambience.screen(app, "lore")
            return
        end
        if screen == "prep" then
            if not (opts and opts.resume) then
                app.campaign.at_prep = nil
                app.save_campaign()   -- between weeks: Session Zero done, or last week's level-up made
                app.campaign:start_week()
            end
            -- From here the board autosaves (A11): quitting mid-prep comes back to it.
            app.campaign.at_prep = true
            app.save_campaign()
            app.prep_dirty = nil
            app.sel = nil
            -- (Back from the lore screen, prep's clock keeps running from where it started.)
            if not (opts and opts.from_lore and app.prep_started) then
                app.prep_started = app.time
            end
            -- Back to the campfire vignette, everyone in their chair.
            msg.post(TABLE, "vignette")
            app.paint_dice()
            app.update_shelf()
            app.place_keepsakes(require("game.model.keepsakes").new_this_week(app.campaign))
            app.place_handouts()
            -- Everyone at the table in their chair; a chair waits for whoever joins later (October 15).
            local seated = {}
            for _, key in ipairs(require("game.model.content").players.order) do
                seated[key] = app.campaign:player(key) ~= nil
            end
            msg.post(TABLE, "seats", { present = seated })
            -- The room, a step at a time (October 26): your friends' heads tracked for their bubbles.
            app.posed = nil
            app.zoom(1)
            msg.post(TABLE, "track", { on = true })
        elseif screen == "night" then
            -- Save the board first (the fix pass): quitting anywhere in the night, or a night
            -- that gets stuck, comes back to the start of this night with the prep intact.
            app.campaign.at_night = true
            app.save_campaign()
            app.prep_seconds = app.time - (app.prep_started or app.time)
            app.night_started = app.time
            app.screen = "night"
            kit.clear_all()
            app.layers = {}
            app.paint_dice()
            app.place_keepsakes()
            app.place_handouts()
            night_view.start(app)
            block_camera(false)
            if app.debug then
                debug_view.build(app)
            end
            ambience.screen(app, "night")
            return
        elseif screen == "setup" then
            -- A fresh start: the first step, the room, and your friends' heads tracked for their bubbles.
            app.setup = nil
            steps_view.reset(app, setup_view.flow)
            app.zoom(1)
            msg.post(TABLE, "track", { on = true })
            app.screen = "setup"
            build_screen(self)
            ambience.screen(app, "session_zero")
            return
        elseif screen == "slice_end" then
            app.slice = nil
            app.awards = nil      -- picked fresh when the scrapbook opens
            app.zoom(1)
        elseif screen == "report" then
            msg.post(TABLE, "track", { on = false })
            app.campaign:finish_night()
            write_playtest_line(app, telemetry.week_record(app.campaign, app.prep_seconds,
                app.time - (app.night_started or app.time)))
            app.save_campaign()
            app.zoom(1)
        end
        app.screen = screen
        build_screen(self)
        ambience.screen(app, screen)
    end

    -- Every button click ticks (M7).
    kit.on_press = function()
        ambience.sfx("click")
    end
    ambience.screen(app, "intro")
    -- Real-click tracing for tools/tests/ui_play/ (off in every normal build).
    app.input_trace = input_trace.start()
    -- The in-engine autotest (tools/tests/engine_check.sh); off in every normal build.
    local ok_at, at_mode = pcall(sys.get_config_int, "behind_the_screen.autotest", 0)
    if ok_at and at_mode and at_mode > 0 then
        require("game.ui.autotest").start(app, at_mode)
    end

    msg.post(HUD, "game_mode", { on = true })
    msg.post(CAMERA, "game_mode", { on = true })
    app.zoom(1)
    build_screen(self)
end

function update(self, dt)
    if self.guided_app then
        return self.guided_app.update(self, dt)
    end
    local app = self.app
    app.time = app.time + dt
    input_trace.tick(dt)
    if app.autotest then
        guard(self, require("game.ui.autotest").update, app, dt)
    end
    if not app.sandbox then
        guard(self, guide_view.update, app)
        -- A rules word's card: back after its text redraws under a still pointer, and on top.
        guard(self, kit.rehover)
        guard(self, gloss.raise)
    end
    if not self.refocused then
        -- Make sure the UI sits above the camera on the input stack.
        self.refocused = true
        msg.post(".", "acquire_input_focus")
    end
    if app.screen == "night" and not app.sandbox and not app.error_layer then
        guard(self, night_view.update, app, dt)
    end
    -- Prep autosaves (A11), a few seconds after the board last changed.
    if app.screen == "prep" and app.prep_dirty and app.campaign.at_prep and app.time - (app.last_autosave or 0) >= 4 then
        app.prep_dirty = nil
        app.last_autosave = app.time
        app.save_campaign()
    end
end

-- Quitting mid-prep keeps the board (A11).
function final(self)
    if self.guided_app then
        return self.guided_app.final(self)
    end
    local app = self.app
    if app and app.screen == "prep" and app.campaign and app.campaign.at_prep then
        app.save_campaign()
    end
end

function on_message(self, message_id, message, sender)
    if self.guided_app then
        return self.guided_app.on_message(self, message_id, message, sender)
    end
    local app = self.app
    if message_id == hash("anchors") then
        -- Where heads and minis are on screen, from the table, every frame of game night.
        if app.screen == "night" then
            night_view.on_anchors(app, message)
        elseif app.screen == "setup" or app.screen == "join" or app.screen == "prep" then
            -- Setting up and prep, a step at a time: their bubbles follow their heads (October 26).
            steps_view.on_anchors(app, message)
        end
    elseif message_id == hash("roll_result") then
        -- In the sandbox the night is paused; it rolls for itself if the die never comes back.
        if app.screen == "night" and app.rolling and not app.sandbox and not app.error_layer then
            guard(self, night_view.on_roll, app, message.value)
        end
    end
end

local function toggle_sandbox(self)
    local app = self.app
    app.sandbox = not app.sandbox
    msg.post(HUD, "game_mode", { on = not app.sandbox })
    msg.post(CAMERA, "game_mode", { on = not app.sandbox })
    build_screen(self)
    if app.sandbox then
        block_camera(false)
    end
end

function on_input(self, action_id, action)
    if self.guided_app then
        return self.guided_app.on_input(self, action_id, action)
    end
    local app = self.app
    if action_id == A.touch and input_trace.on then
        input_trace.touch(action)
    end
    if action_id == A.sandbox and action.pressed and app.dev_keys then
        toggle_sandbox(self)
        return true
    end
    if app.sandbox then
        return false
    end
    if action_id == A.review and action.pressed and review_view.available() then
        guard(self, review_view.toggle, app)
        return true
    end
    if app.review and app.review.queue_open then
        -- The review queue takes the keyboard (and its own buttons take the clicks).
        if guard(self, review_view.on_input, app, action_id, action) then
            return true
        end
        if action_id == nil then
            if action.x then
                kit.on_move(action.x, action.y)
            end
            return true
        end
        if action_id == A.touch and action.pressed then
            guard(self, kit.on_click, action.x, action.y)
        end
        return true
    end
    -- Typing an answer in the slice survey (M7) takes the keyboard.
    if app.screen == "slice_end" and slice_end_view.typing(app) then
        if action_id == A.text then
            guard(self, slice_end_view.on_text, app, action.text)
            return true
        elseif action_id == A.backspace and (action.pressed or action.repeated) then
            guard(self, slice_end_view.on_backspace, app)
            return true
        elseif action_id == A.back and action.pressed then
            app.slice.focus = nil
            app.refresh()
            return true
        end
    end
    -- Typing the DM's note on the session report (B7).
    if report_view.typing(app) then
        if action_id == A.text then
            guard(self, report_view.on_text, app, action.text)
            return true
        elseif action_id == A.backspace and (action.pressed or action.repeated) then
            guard(self, report_view.on_backspace, app)
            return true
        elseif (action_id == A.back or action_id == A.confirm) and action.pressed then
            app.report_note = nil
            app.refresh()
            return true
        elseif action_id ~= A.touch and action_id ~= nil then
            return true
        end
    end
    if action_id == A.music and action.pressed and not (app.screen == "slice_end" and slice_end_view.typing(app)) then
        -- M: music off and on (the rain and the effects stay).
        ambience.toggle_music()
        return true
    end
    -- Esc on what's on top: the "are you sure?" (its no), a book you're reading, a finished
    -- one-on-one (October 20: these three ignored it).
    if action_id == A.back and action.pressed and (app.ask or app.book or (app.talk and app.talk.done)) then
        if app.ask then
            guard(self, ask_view.cancel, app)
        elseif app.book then
            guard(self, book_view.close, app)
        else
            app.talk = nil
            app.refresh()
        end
        return true
    end
    -- The DM's notes, a character sheet or the encounter builder: Esc closes, N opens the notes.
    if app.overlay and action_id == A.back and action.pressed then
        guard(self, app.close_overlay)
        return true
    end
    if action_id == A.notes and action.pressed and not (app.review and app.review.queue_open)
        and (app.screen == "prep" or app.screen == "night" or app.screen == "report") and not app.convo
        and not app.ask and not app.talk and not app.book then   -- (not under an open book or talk, October 20)
        if app.overlay == "notes" then
            guard(self, app.close_overlay)
        else
            guard(self, app.open_notes)
        end
        return true
    end
    -- S: the Story log. On the prep board it's the panel beside the board; on game night and the
    -- report it's the Story log page in your notes, on the scene's own storyline.
    if action_id == A.story and action.pressed and not (app.review and app.review.queue_open) and not app.convo
        and not report_view.typing(app) and not (app.screen == "slice_end" and slice_end_view.typing(app)) then
        if app.screen == "prep" and not app.overlay and not app.ask and not app.talk and not app.book then
            guard(self, function()
                story_log_view.toggle_panel(app)
                app.refresh()
            end)
            return true
        elseif app.screen == "prep" or app.screen == "night" or app.screen == "report" then
            if app.overlay == "notes" and app.notes_tab == "storylog" then
                guard(self, app.close_overlay)
            else
                local sc = app.screen == "night" and app.night and app.night.scene
                if sc and sc.stories and sc.stories[1] and app.overlay ~= "notes" then
                    app.storylog_id = sc.stories[1]
                    app.storylog_scroll = nil
                end
                guard(self, app.open_notes, "storylog")
            end
            return true
        end
    end
    -- The mouse wheel reads the Story log when the pointer's on it.
    if (action_id == A.wheel_up or action_id == A.wheel_down) and action.pressed and action.x then
        local took = false
        guard(self, function()
            took = story_log_view.on_wheel(app, action.x, action.y, action_id == A.wheel_up and -1 or 1)
        end)
        if took then
            return true
        end
    end
    if app.overlay and (action_id == A.confirm or action_id == A.roll) and action.pressed then
        return true   -- the table waits while you read
    end
    -- The lore screen: Esc goes back to the prep board.
    if action_id == A.back and action.pressed and app.screen == "lore" and not app.ask then
        guard(self, lore_view.back, app)
        return true
    end
    if action_id == A.back and action.pressed and (app.convo or app.levelup) then
        -- Esc closes a conversation or the level-up moment.
        if app.levelup then
            guard(self, levelup_view.close, app)
        else
            guard(self, messages_view.close, app)
        end
        return true
    end
    if action_id == A.queue and action.pressed and app.review and app.review.on and app.screen == "night" then
        guard(self, review_view.open_queue, app)
        return true
    end
    if action_id == A.debug and action.pressed and app.dev_keys then
        app.debug = not app.debug
        if app.debug then
            debug_view.build(app)
        else
            debug_view.hide(app)
        end
        return true
    end
    if action_id == nil then
        if action.x then
            kit.on_move(action.x, action.y)
            review_view.on_move(app, action.x, action.y)
        end
        return false
    end
    if action_id == A.touch and action.pressed then
        if guard(self, kit.on_click, action.x, action.y) then
            return true
        end
        return app.screen ~= "night"
    end
    if action_id == A.confirm and action.pressed then
        -- Enter takes the screen's main step forward.
        local s = app.screen
        if app.levelup then
            guard(self, levelup_view.close, app)
            return true
        elseif app.convo then
            return true
        elseif s == "intro" then
            -- Enter takes the main button: Continue when there's a save, else Session Zero.
            if app.resume then
                guard(self, app.continue_campaign)
            else
                guard(self, app.go, "setup")
            end
            return true
        elseif s == "setup" then
            guard(self, setup_view.next, app)
            return true
        elseif s == "join" then
            guard(self, setup_view.next_join, app)
            return true
        elseif s == "lore" then
            guard(self, lore_view.go, app)
            return true
        elseif s == "report" then
            if not report_view.busy(app) then
                guard(self, report_view.next, app)
            end
            return true
        elseif s == "slice_end" then
            local st = app.slice
            if st and st.stage == "survey" then
                if st.focus then
                    st.focus = nil
                    app.refresh()
                else
                    guard(self, slice_end_view.save, app)
                end
            elseif st and st.stage == "scrapbook" and not st.saved then
                st.stage = "survey"
                app.refresh()
            else
                guard(self, app.go, "prep")
            end
            return true
        elseif s == "prep" then
            if app.ask or app.talk or app.book or app.overlay then
                return true   -- the "are you sure?", the one-on-one, the book and your notes answer with their buttons
            end
            guard(self, prep_steps.next, app)     -- the next step, or game night from the last (October 26)
            return true
        elseif s == "night" and app.night_done then
            guard(self, app.go, "report")
            return true
        end
    end
    if app.screen == "night" then
        -- A card is up: number keys pick its options, Enter plays the improv cards you picked.
        if app.pending and not app.overlay and NUMKEY[action_id] then
            if action.pressed then
                guard(self, night_view.pick_key, app, NUMKEY[action_id])
            end
            return true
        end
        if app.pending and (action_id == A.roll or action_id == A.confirm) and action.pressed
            and app.pending.kind == "improv" then
            guard(self, night_view.play_improv, app)
            return true
        end
        -- The opening and the briefing: Space or Enter turns the page.
        if app.pending and (action_id == A.roll or action_id == A.confirm) and action.pressed
            and app.pending.kind == "cinematic" then
            guard(self, night_view.cinematic_next, app)
            return true
        end
        -- The mouse wheel scrolls the open log when it's over it (and zooms the camera elsewhere).
        if (action_id == A.wheel_up or action_id == A.wheel_down) and night_view.over_log(app, action.x, action.y) then
            if action.pressed then
                guard(self, night_view.scroll_log, app, action_id == A.wheel_up and 3 or -3)
            end
            return true
        end
        if (action_id == A.roll or action_id == A.confirm) and action.pressed then
            guard(self, night_view.skip, app)
            return true
        end
        if action.pressed then
            if action_id == A.fast then
                guard(self, night_view.cycle_speed, app)
                return true
            elseif action_id == A.slow then
                guard(self, night_view.slow_down, app)
                return true
            elseif action_id == A.log then
                guard(self, night_view.toggle_log, app)
                return true
            elseif action_id == A.timer then
                guard(self, night_view.toggle_timer, app)
                return true
            elseif action_id == A.dm_rolls then
                guard(self, night_view.toggle_dm_rolls, app)
                return true
            elseif action_id == A.snapshot then
                guard(self, night_view.take_snapshot, app)
                return true
            end
        end
        return false
    end
    -- Prep, report and intro screens keep the camera still.
    return true
end
